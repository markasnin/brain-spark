rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function own(id) { return signed() && request.auth.uid == id; }
    function profile(id) { return get(/databases/$(database)/documents/familyProfiles/$(id)).data; }
    function link(id) { return get(/databases/$(database)/documents/familyLinks/$(id)).data; }
    function member(l) { return own(l.parent) || own(l.child); }
    function validGrade(g) { return g in ['א','ב','ג','ד','ה','ו','ז']; }
    match /users/{userId} {
      allow read: if signed();
      allow write: if own(userId);
    }
    match /familyProfiles/{id} {
      allow get: if own(id) || (signed() && link(request.auth.uid + '_' + id).accepted == true);
      function validProfile(d) {
        return (d.role == 'parent' && d.keys().hasOnly(['role'])) ||
          (d.role == 'child' && d.keys().hasOnly(['role','grade']) && validGrade(d.grade));
      }
      allow create: if own(id) && validProfile(request.resource.data)
        && (request.resource.data.role == 'parent' || existsAfter(slotsPath(id)));
      allow update: if own(id) && validProfile(request.resource.data) && request.resource.data.role == resource.data.role;
    }
    function slotsPath(child) {
      return /databases/$(database)/documents/familyParentSlots/$(child);
    }
    function familyLinkPath(parent,child) {
      return /databases/$(database)/documents/familyLinks/$(parent + '_' + child);
    }
    function slotsAfter(child) { return getAfter(slotsPath(child)).data; }
    match /familyParentSlots/{child} {
      allow get: if own(child) || own(resource.data.first) || own(resource.data.second);
      allow list: if own(resource.data.first) || own(resource.data.second);
      allow create: if own(child) && !exists(/databases/$(database)/documents/familyProfiles/$(child))
        && request.resource.data.keys().hasOnly(['first','second','approved'])
        && request.resource.data.first == '' && request.resource.data.second == ''
        && request.resource.data.approved == false;

      function reserve(old,next) {
        return own(child) && !next.approved && (
          (old.first == '' && next.first != '' && next.second == ''
            && existsAfter(familyLinkPath(next.first,child))) ||
          (old.first != '' && old.second == '' && next.first == old.first
            && next.second != '' && next.second != old.first
            && get(familyLinkPath(old.first,child)).data.accepted == true
            && existsAfter(familyLinkPath(next.second,child)))
        );
      }
      function release(old,next) {
        return !next.approved && (
          (old.second != '' && (own(child) || own(old.second))
            && next.second == '' && next.first == old.first
            && !existsAfter(familyLinkPath(old.second,child))) ||
          (old.first != '' && (own(child) || own(old.first))
            && next.second == ''
            && ((old.second == '' || old.approved) && next.first == old.second
              || (old.second != '' && !old.approved && next.first == '' && !existsAfter(familyLinkPath(old.second,child))))
            && !existsAfter(familyLinkPath(old.first,child)))
        );
      }
      allow update: if request.resource.data.keys().hasOnly(['first','second','approved'])
        && request.resource.data.first is string && request.resource.data.second is string
        && request.resource.data.approved is bool
        && (reserve(resource.data,request.resource.data) || release(resource.data,request.resource.data)
          || (own(resource.data.first) && resource.data.second != '' && !resource.data.approved
            && get(familyLinkPath(resource.data.first,child)).data.accepted == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approved'])
            && request.resource.data.approved));
    }
    match /familyLinks/{id} {
      allow read: if member(resource.data);
      allow create: if own(request.resource.data.child) && request.resource.data.keys().hasOnly(['parent','child','name','accepted'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 120
        && request.resource.data.parent != request.resource.data.child
        && id == request.resource.data.parent + '_' + request.resource.data.child
        && profile(request.resource.data.parent).role == 'parent' && profile(request.resource.data.child).role == 'child'
        && request.resource.data.accepted == false
        && (slotsAfter(request.resource.data.child).first == request.resource.data.parent
          || slotsAfter(request.resource.data.child).second == request.resource.data.parent);
      allow update: if own(resource.data.parent) && resource.data.accepted == false
        && (slotsAfter(resource.data.child).first == resource.data.parent ||
          (slotsAfter(resource.data.child).second == resource.data.parent && slotsAfter(resource.data.child).approved))
        && request.resource.data.accepted == true && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted']);
      function deletingPendingSecond(d) {
        let old = get(slotsPath(d.child)).data;
        return own(old.first) && old.second == d.parent && !old.approved
          && !existsAfter(familyLinkPath(old.first,d.child));
      }
      allow delete: if (member(resource.data) || deletingPendingSecond(resource.data))
        && slotsAfter(resource.data.child).first != resource.data.parent
        && slotsAfter(resource.data.child).second != resource.data.parent;
      match /tasks/{taskId} {
        function authorized() { return signed() && member(link(id)) && link(id).accepted == true; }
        allow read: if authorized();
        function validTask(d) {
          return d.keys().hasOnly(['parent','child','grade','parts','total','index','correct','answers','created','completed'])
            && own(d.parent) && d.parent == link(id).parent && d.child == link(id).child
            && d.grade == profile(d.child).grade && d.parts is list && d.parts.size() > 0
            && d.total is int && d.total >= d.parts.size() && d.total <= 100
            && d.index == 0 && d.correct == 0 && d.answers == [] && d.created == request.time && d.completed == null;
        }
        function validResponse(d,old) {
          let previous = old.get('responses', []);
          let entry = d.responses[previous.size()];
          return d.responses == previous.concat([entry]) && entry.keys().hasOnly(['index','value','expected','prompts'])
            && entry.index == old.index && entry.value is string && entry.value.size() <= 128
            && entry.expected is string && entry.expected.size() <= 128
            && entry.prompts is map && entry.prompts.keys().hasAll(['he','en','fr','uk','ar','ru'])
            && entry.prompts.keys().hasOnly(['he','en','fr','uk','ar','ru']);
        }
        function oneAnswer(d,old) {
          return own(old.child) && old.index < old.total && d.index == old.index + 1
            && d.diff(old).affectedKeys().hasOnly(['index','correct','answers','completed','responses'])
            && (!d.diff(old).affectedKeys().hasAny(['responses']) || validResponse(d,old))
            && (d.correct == old.correct || d.correct == old.correct + 1)
            && d.answers == old.answers.concat([d.correct > old.correct])
            && (d.index == old.total ? d.completed == request.time : d.completed == null);
        }
        allow create: if authorized() && validTask(request.resource.data);
        allow update: if authorized() && oneAnswer(request.resource.data,resource.data);
      }
    }
  }
}
